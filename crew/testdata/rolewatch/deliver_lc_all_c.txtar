# The frame gate does not depend on the locale: under LC_ALL=C the multibyte
# prompt glyphs and rules still classify, and each engine gets its delivery.
exec git init -q
mkdir .git/crew
mkdir tmux/frames
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock
env LC_ALL=C

# claude on rw_idle.txt
rm tmux.log tmux/n.alive tmux/n.capture tmux/n.enter tmux/buffer tmux/loads
cp events.jsonl .git/crew/events.jsonl
cp $FRAMES/rw_idle.txt tmux/frames/1
cp $FRAMES/rw_claude_held.txt tmux/frames/2
cp $FRAMES/rw_idle.txt tmux/frames/3
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
cmp tmux/loads want.loads
grep -count=1 '^paste-buffer' tmux.log
grep -count=1 '^send-keys -t %6 Enter$' tmux.log
! grep '^send-keys -t %6 C-u' tmux.log

# codex on rw_codex_idle_empty.txt
rm tmux.log tmux/n.alive tmux/n.capture tmux/n.enter tmux/buffer tmux/loads
cp events.jsonl .git/crew/events.jsonl
cp $FRAMES/rw_codex_idle_empty.txt tmux/frames/1
cp $FRAMES/rw_codex_after_assignment.txt tmux/frames/2
cp $FRAMES/rw_codex_idle_empty.txt tmux/frames/3
exec crew role-watch reviewer --pane %6 --engine codex --branch feat/9-x --interval 0.2
! stderr .
cmp tmux/loads want.loads
grep -count=1 '^paste-buffer' tmux.log
grep -count=1 '^send-keys -t %6 Enter$' tmux.log
! grep '^send-keys -t %6 C-u' tmux.log

# cursor on rw_cursor_idle_empty.txt
rm tmux.log tmux/n.alive tmux/n.capture tmux/n.enter tmux/buffer tmux/loads
cp events.jsonl .git/crew/events.jsonl
cp $FRAMES/rw_cursor_idle_empty.txt tmux/frames/1
cp $FRAMES/rw_cursor_after_assignment.txt tmux/frames/2
cp $FRAMES/rw_cursor_idle_empty.txt tmux/frames/3
exec crew role-watch reviewer --pane %6 --engine cursor --branch feat/9-x --interval 0.2
! stderr .
cmp tmux/loads want.loads
grep -count=1 '^paste-buffer' tmux.log
grep -count=1 '^send-keys -t %6 Enter$' tmux.log
! grep '^send-keys -t %6 C-u' tmux.log

-- events.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"go"}
-- clock --
1000
-- want.loads --
1 Assignment: go
-- tmux/state --
role=reviewer
window=@1
branch=feat/9-x
crew=c1
exited=0
lifetime=6
