# A body with a tab is rejected, never typed: assignment_rejected goes to the
# sender (the lead worker too, one row), and the queue proceeds to the next
# safe body on the following tick.
exec git init -q
mkdir .git/crew
cp events.jsonl .git/crew/events.jsonl
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
grep -count=1 'assignment_rejected' .git/crew/events.jsonl
grep '"to":"worker:feat/9-x#s1-1".*assignment_rejected.*control character' .git/crew/events.jsonl
grep -count=1 '^paste-buffer' tmux.log
grep -count=1 '^load-buffer' tmux.log
grep '\AAssignment: ok\z' tmux/buffer
grep -count=1 '^send-keys -t %6 Enter$' tmux.log

-- events.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"go\tnow"}
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"ok"}
-- clock --
1000
-- tmux/state --
role=reviewer
window=@1
branch=feat/9-x
crew=c1
exited=0
lifetime=7
