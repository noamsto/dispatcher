# A pull role's `working` status with an assignment: detail is the ack. It
# clears the queued assignment, marks the pane working, and no deferral is
# ever reported however long the run lasts.
exec git init -q
mkdir .git/crew
cp events.jsonl .git/crew/events.jsonl
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock
exec crew role-watch reviewer --pane %6 --engine cursor --branch feat/9-x --interval 0.2 --defer-notice 1
! stderr .
! grep '^(capture-pane|send-keys|load-buffer|paste-buffer)' tmux.log
grep -count=1 '^set-option -p -t %6 @crew_state working$' tmux.log
! grep 'assignment_deferred' .git/crew/events.jsonl

-- events.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"go"}
{"ts":10000000000000,"crew_id":"c1","kind":"status","from":"role:feat/9-x:reviewer","body":{"state":"working","detail":"assignment: go"}}
-- clock --
1000
-- tmux/state --
role=reviewer
window=@1
delivery=pull
branch=feat/9-x
crew=c1
exited=0
lifetime=9
