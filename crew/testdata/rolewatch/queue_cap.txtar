# The pending queue holds 50 assignments: 53 posted while the pane sits behind a
# dialog drop the three oldest (m01-m03), so the first paste once the pane is
# idle is m04 and none of the dropped bodies is ever typed.
exec git init -q
mkdir .git/crew
cp events.jsonl .git/crew/events.jsonl
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
grep '\A[0-9]+ Assignment: m04$' tmux/loads
! grep 'Assignment: m0[1-3]$' tmux/loads
! grep '^send-keys -t %6 -l' tmux.log

