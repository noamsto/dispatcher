# An idle claude box: startup stamp reads and the idle ticks, then one typed
# delivery (precheck capture, load/paste, confirming capture, Enter), then the
# submit check, which sees the idle box again and stays quiet.
#
# golden.log is the bash arm's tmux argv log for this fake state, frozen when
# the arm was deleted.
exec git init -q
mkdir .git/crew
cp events.jsonl .git/crew/events.jsonl
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
cmp tmux.log golden.log
grep '\AAssignment: go\z' tmux/buffer
grep -count=1 '^send-keys -t %6 Enter$' tmux.log
! grep '^send-keys -t %6 C-u' tmux.log
! grep '"from":"role:' .git/crew/events.jsonl

-- events.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"go"}
-- clock --
1000
-- tmux/state --
role=reviewer
window=@1
branch=feat/9-x
crew=c1
exited=0
lifetime=6
-- tmux/frames/1 --
