# #725: the idle composer a codex or cursor pane shows after a turn (and cursor's
# startup placeholder) is typed into; look-alikes (a prompt row where codex's
# shortcuts footer is, a cursor frame without its version row or footer path, a
# non-empty draft, a status line that is a prompt or carries a path, a dialog
# overlay) only defer: the pane is captured again and nothing is typed. The
# frames are the captures that issue's tests used, with the ready ones followed
# by the pasted text and, after the Enter, the idle frame again.
exec git init -q
mkdir .git/crew
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock

# codex post-turn idle is typed into
mkdir tmux/frames
cp state.1 tmux/state
cp events.1 .git/crew/events.jsonl
cp clock.base clock
cp f.codex_post-turn_idle tmux/frames/1
cp f.codex_post-turn_typed tmux/frames/2
cp f.codex_post-turn_idle tmux/frames/3
exec crew role-watch reviewer --pane %6 --engine codex --branch feat/9-x --interval 0.2
! stderr .
grep -count=1 '^load-buffer' tmux.log
grep -count=1 '^paste-buffer' tmux.log
grep -count=1 '^send-keys -t %6 Enter$' tmux.log
! grep '^send-keys -t %6 C-u' tmux.log
! grep 'assignment_unsubmitted' .git/crew/events.jsonl

# cursor post-turn idle is typed into
rm tmux.log
rm tmux
mkdir tmux/frames
cp state.2 tmux/state
cp events.2 .git/crew/events.jsonl
cp clock.base clock
cp f.cursor_post-turn_idle tmux/frames/1
cp f.cursor_post-turn_typed tmux/frames/2
cp f.cursor_post-turn_idle tmux/frames/3
exec crew role-watch reviewer --pane %6 --engine cursor --branch feat/9-x --interval 0.2
! stderr .
grep -count=1 '^load-buffer' tmux.log
grep -count=1 '^paste-buffer' tmux.log
grep -count=1 '^send-keys -t %6 Enter$' tmux.log
! grep '^send-keys -t %6 C-u' tmux.log
! grep 'assignment_unsubmitted' .git/crew/events.jsonl

# cursor startup placeholder is typed into
rm tmux.log
rm tmux
mkdir tmux/frames
cp state.3 tmux/state
cp events.3 .git/crew/events.jsonl
cp clock.base clock
cp f.cursor_startup_idle tmux/frames/1
cp f.cursor_startup_typed tmux/frames/2
cp f.cursor_startup_idle tmux/frames/3
exec crew role-watch reviewer --pane %6 --engine cursor --branch feat/9-x --interval 0.2
! stderr .
grep -count=1 '^load-buffer' tmux.log
grep -count=1 '^paste-buffer' tmux.log
grep -count=1 '^send-keys -t %6 Enter$' tmux.log
! grep '^send-keys -t %6 C-u' tmux.log
! grep 'assignment_unsubmitted' .git/crew/events.jsonl

# codex look-alike defers, nothing typed
rm tmux.log
rm tmux
mkdir tmux/frames
cp state.4 tmux/state
cp events.4 .git/crew/events.jsonl
cp clock.base clock
cp f.codex_look_alike tmux/frames/1
exec crew role-watch reviewer --pane %6 --engine codex --branch feat/9-x --interval 0.2
! stderr .
grep '(?s)capture-pane.*capture-pane' tmux.log
! grep '^(send-keys|load-buffer|paste-buffer)' tmux.log

# cursor frame without a version row defers, nothing typed
rm tmux.log
rm tmux
mkdir tmux/frames
cp state.5 tmux/state
cp events.5 .git/crew/events.jsonl
cp clock.base clock
cp f.cursor_frame_without_a_version_row tmux/frames/1
exec crew role-watch reviewer --pane %6 --engine cursor --branch feat/9-x --interval 0.2
! stderr .
grep '(?s)capture-pane.*capture-pane' tmux.log
! grep '^(send-keys|load-buffer|paste-buffer)' tmux.log

# cursor footer with no path defers, nothing typed
rm tmux.log
rm tmux
mkdir tmux/frames
cp state.6 tmux/state
cp events.6 .git/crew/events.jsonl
cp clock.base clock
cp f.cursor_footer_with_no_path tmux/frames/1
exec crew role-watch reviewer --pane %6 --engine cursor --branch feat/9-x --interval 0.2
! stderr .
grep '(?s)capture-pane.*capture-pane' tmux.log
! grep '^(send-keys|load-buffer|paste-buffer)' tmux.log

# cursor non-empty draft defers, nothing typed
rm tmux.log
rm tmux
mkdir tmux/frames
cp state.7 tmux/state
cp events.7 .git/crew/events.jsonl
cp clock.base clock
cp f.cursor_non_empty_draft tmux/frames/1
exec crew role-watch reviewer --pane %6 --engine cursor --branch feat/9-x --interval 0.2
! stderr .
grep '(?s)capture-pane.*capture-pane' tmux.log
! grep '^(send-keys|load-buffer|paste-buffer)' tmux.log

# cursor status line that is a prompt defers, nothing typed
rm tmux.log
rm tmux
mkdir tmux/frames
cp state.8 tmux/state
cp events.8 .git/crew/events.jsonl
cp clock.base clock
cp f.cursor_status_line_that_is_a_prompt tmux/frames/1
exec crew role-watch reviewer --pane %6 --engine cursor --branch feat/9-x --interval 0.2
! stderr .
grep '(?s)capture-pane.*capture-pane' tmux.log
! grep '^(send-keys|load-buffer|paste-buffer)' tmux.log

# cursor status line with an embedded path defers, nothing typed
rm tmux.log
rm tmux
mkdir tmux/frames
cp state.9 tmux/state
cp events.9 .git/crew/events.jsonl
cp clock.base clock
cp f.cursor_status_line_with_an_embedded_path tmux/frames/1
exec crew role-watch reviewer --pane %6 --engine cursor --branch feat/9-x --interval 0.2
! stderr .
grep '(?s)capture-pane.*capture-pane' tmux.log
! grep '^(send-keys|load-buffer|paste-buffer)' tmux.log

# cursor dialog overlay defers, nothing typed
rm tmux.log
rm tmux
mkdir tmux/frames
cp state.10 tmux/state
cp events.10 .git/crew/events.jsonl
cp clock.base clock
cp f.cursor_dialog_overlay tmux/frames/1
exec crew role-watch reviewer --pane %6 --engine cursor --branch feat/9-x --interval 0.2
! stderr .
grep '(?s)capture-pane.*capture-pane' tmux.log
! grep '^(send-keys|load-buffer|paste-buffer)' tmux.log

