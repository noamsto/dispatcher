# A pi live turn (the spinner row replaces the top rule) defers: the box is
# captured tick after tick and nothing is sent. Once the turn ends (idle frame)
# the assignment goes out exactly once. Both also hold under LC_ALL=C, where a
# locale-bound classifier would misread the box-drawing runes.
exec git init -q
mkdir .git/crew
mkdir tmux/frames
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock

# a turn that never ends
cp events.jsonl .git/crew/events.jsonl
cp $FRAMES/rw_pi_live.txt tmux/frames/1
exec crew role-watch reviewer --pane %6 --engine pi --branch feat/9-x --interval 0.2
! stderr .
grep '(?s)capture-pane.*capture-pane' tmux.log
! grep '^(send-keys|load-buffer|paste-buffer)' tmux.log

# the same under LC_ALL=C
rm tmux.log tmux/n.alive tmux/n.capture
cp events.jsonl .git/crew/events.jsonl
env LC_ALL=C
exec crew role-watch reviewer --pane %6 --engine pi --branch feat/9-x --interval 0.2
! stderr .
grep '(?s)capture-pane.*capture-pane' tmux.log
! grep '^(send-keys|load-buffer|paste-buffer)' tmux.log

# a turn that ends: two live captures, then the one delivery (LC_ALL=C still set)
rm tmux.log tmux/n.alive tmux/n.capture tmux/n.enter tmux/loads
cp events.jsonl .git/crew/events.jsonl
cp $FRAMES/rw_pi_live.txt tmux/frames/2
cp $FRAMES/rw_pi_idle.txt tmux/frames/3
cp $FRAMES/rw_pi_held.txt tmux/frames/4
cp $FRAMES/rw_pi_idle.txt tmux/frames/5
exec crew role-watch reviewer --pane %6 --engine pi --branch feat/9-x --interval 0.2
! stderr .
grep -count=1 '^load-buffer' tmux.log
grep -count=1 '^paste-buffer' tmux.log
grep -count=1 '^send-keys -t %6 Enter$' tmux.log
grep '(?s)capture-pane.*capture-pane.*load-buffer.*paste-buffer.*capture-pane.*send-keys -t %6 Enter' tmux.log
grep '\AAssignment: go\z' tmux/buffer
! grep '^send-keys -t %6 C-u' tmux.log

# an idle pi box under LC_ALL=C is delivered to as well
rm tmux.log tmux/n.alive tmux/n.capture tmux/n.enter tmux/loads
cp events.jsonl .git/crew/events.jsonl
cp $FRAMES/rw_pi_idle.txt tmux/frames/1
cp $FRAMES/rw_pi_held.txt tmux/frames/2
cp $FRAMES/rw_pi_idle.txt tmux/frames/3
exec crew role-watch reviewer --pane %6 --engine pi --branch feat/9-x --interval 0.2
! stderr .
grep -count=1 '^paste-buffer' tmux.log
grep -count=1 '^send-keys -t %6 Enter$' tmux.log

-- events.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"go"}
-- clock --
1000
-- tmux/state --
role=reviewer
window=@1
branch=feat/9-x
crew=c1
exited=0
lifetime=8
