# The first Enter after the paste is lost and the box still shows the
# assignment: the watcher retries Enter alone, never a re-paste, and the turn it
# starts is the 4th capture. One script per engine.
exec git init -q
mkdir .git/crew
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock

# pi: swallowed first Enter
mkdir tmux/frames
cp state.1 tmux/state
cp events.1 .git/crew/events.jsonl
cp clock.base clock
cp $FRAMES/rw_pi_idle.txt tmux/frames/1
cp $FRAMES/rw_pi_held.txt tmux/frames/2
cp $FRAMES/rw_pi_live.txt tmux/frames/4
exec crew role-watch reviewer --pane %6 --engine pi --branch feat/9-x --interval 0.2
! stderr .
grep -count=2 '^send-keys -t %6 Enter$' tmux.log
grep -count=1 '^load-buffer' tmux.log
grep -count=1 '^paste-buffer' tmux.log
! grep '^send-keys -t %6 C-u' tmux.log
! grep 'assignment_unsubmitted' .git/crew/events.jsonl
grep '^4$' tmux/n.capture

# claude: swallowed first Enter
rm tmux.log
rm tmux
mkdir tmux/frames
cp state.2 tmux/state
cp events.2 .git/crew/events.jsonl
cp clock.base clock
cp $FRAMES/rw_idle.txt tmux/frames/1
cp $FRAMES/rw_claude_held.txt tmux/frames/2
cp $FRAMES/rw_live.txt tmux/frames/4
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
grep -count=2 '^send-keys -t %6 Enter$' tmux.log
grep -count=1 '^load-buffer' tmux.log
grep -count=1 '^paste-buffer' tmux.log
! grep '^send-keys -t %6 C-u' tmux.log
! grep 'assignment_unsubmitted' .git/crew/events.jsonl
grep '^4$' tmux/n.capture

# codex: swallowed first Enter
rm tmux.log
rm tmux
mkdir tmux/frames
cp state.3 tmux/state
cp events.3 .git/crew/events.jsonl
cp clock.base clock
cp $FRAMES/rw_codex_idle_empty.txt tmux/frames/1
cp $FRAMES/rw_codex_after_assignment.txt tmux/frames/2
cp $FRAMES/rw_codex_live_turn.txt tmux/frames/4
exec crew role-watch reviewer --pane %6 --engine codex --branch feat/9-x --interval 0.2
! stderr .
grep -count=2 '^send-keys -t %6 Enter$' tmux.log
grep -count=1 '^load-buffer' tmux.log
grep -count=1 '^paste-buffer' tmux.log
! grep '^send-keys -t %6 C-u' tmux.log
! grep 'assignment_unsubmitted' .git/crew/events.jsonl
grep '^4$' tmux/n.capture

# cursor: swallowed first Enter
rm tmux.log
rm tmux
mkdir tmux/frames
cp state.4 tmux/state
cp events.4 .git/crew/events.jsonl
cp clock.base clock
cp $FRAMES/rw_cursor_idle_empty.txt tmux/frames/1
cp $FRAMES/rw_cursor_after_assignment.txt tmux/frames/2
cp $FRAMES/rw_cursor_live_turn.txt tmux/frames/4
exec crew role-watch reviewer --pane %6 --engine cursor --branch feat/9-x --interval 0.2
! stderr .
grep -count=2 '^send-keys -t %6 Enter$' tmux.log
grep -count=1 '^load-buffer' tmux.log
grep -count=1 '^paste-buffer' tmux.log
! grep '^send-keys -t %6 C-u' tmux.log
! grep 'assignment_unsubmitted' .git/crew/events.jsonl
grep '^4$' tmux/n.capture

-- clock.base --
1000
-- state.1 --
role=reviewer
window=@1
branch=feat/9-x
crew=c1
exited=0
lifetime=14
-- events.1 --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"go"}
