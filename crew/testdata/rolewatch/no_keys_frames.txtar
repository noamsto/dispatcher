# Frames that are not an idle input box for their engine never receive keys:
# the watcher keeps capturing (at least twice) and types nothing. The frames are
# the shared classifier fixtures, so each engine/frame pair here is the one the
# classifier tables use.
exec git init -q
mkdir .git/crew
mkdir tmux/frames
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock

# claude rw_select.txt
rm tmux.log tmux/n.alive tmux/n.capture tmux/n.enter tmux/buffer tmux/loads
cp events.jsonl .git/crew/events.jsonl
cp $FRAMES/rw_select.txt tmux/frames/1
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
grep '(?s)capture-pane.*capture-pane' tmux.log
! grep '^(send-keys|load-buffer|paste-buffer)' tmux.log

# claude rw_quota.txt
rm tmux.log tmux/n.alive tmux/n.capture tmux/n.enter tmux/buffer tmux/loads
