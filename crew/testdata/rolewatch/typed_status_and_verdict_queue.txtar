# A typed pane ignores status rows: the assignment behind a `working` status
# (even one whose detail looks like an ack) is still delivered, exactly once.
# And a role verdict does not flip a role idle while an assignment is still
# queued: marked working on enqueue, never idle again behind the dialog.
exec git init -q
mkdir .git/crew
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock

# status rows are ignored
cp events-status.jsonl .git/crew/events.jsonl
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
grep -count=1 '^load-buffer' tmux.log
grep -count=1 '^paste-buffer' tmux.log
grep -count=1 '^send-keys -t %6 Enter$' tmux.log
grep '\AAssignment: plan the seam\z' tmux/buffer

# a verdict with an assignment queued behind a dialog
rm tmux.log tmux/n.alive tmux/n.capture tmux/n.enter tmux/loads tmux/frames/2 tmux/frames/3
cp permission tmux/frames/1
cp events-verdict.jsonl .git/crew/events.jsonl
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
grep -count=1 '^set-option -p -t %6 @crew_state working$' tmux.log
grep -count=1 '^set-option -p -t %6 @crew_state idle$' tmux.log
! grep '(?s)@crew_state working\n.*@crew_state idle' tmux.log
! grep '^(send-keys|load-buffer|paste-buffer)' tmux.log

-- events-status.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"status","from":"role:feat/9-x:reviewer","to":"dispatcher:c1","body":{"state":"working"}}
{"ts":10000000000000,"crew_id":"c1","kind":"status","from":"role:feat/9-x:reviewer","to":"dispatcher:c1","body":{"state":"working","detail":"assignment: plan"}}
{"ts":10000000000001,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"plan the seam"}
-- events-verdict.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"go"}
{"ts":10000000000000,"crew_id":"c1","kind":"msg","from":"role:feat/9-x:reviewer","to":"worker:feat/9-x#s1-1","body":"{}"}
-- clock --
1000
