# After the Enter the pane matches no known frame and is below the width floor
# (min_cols unset: 20): the watcher re-guards the window (set-window-option,
# select-layout main-vertical), at most 3 times, before the unknown ticks count.
#
# golden.log is the bash arm's tmux argv log for this fake state, frozen when
# the arm was deleted.
exec git init -q
mkdir .git/crew
cp events.jsonl .git/crew/events.jsonl
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
cmp tmux.log golden.log
stderr -count=1 'role-watch: pane %6 was 10 cols \(min 20\) mid-run — re-guarded window @1 \(attempt 1/3\): layout L0 -> L0'
stderr -count=3 'dispatch: role pane %6 is 10 cols \(min 20\) after refit — window_layout=L0; applying main-vertical fallback'
stderr -count=1 'attempt 3/3'
! stderr 'attempt 4/3'
grep -count=3 '^display-message -p -t @1 #\{window_zoomed_flag\}$' tmux.log
grep -count=6 '^show-options -w -v -q -t @1 @grid_refit_min_role_cols$' tmux.log
grep -count=3 '^set-window-option -t @1 main-pane-width 60%$' tmux.log
grep -count=3 '^select-layout -t @1 main-vertical$' tmux.log
grep -count=1 '^send-keys -t %6 Enter$' tmux.log

-- events.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"go"}
-- clock --
1000
-- tmux/state --
role=reviewer
window=@1
branch=feat/9-x
crew=c1
exited=0
lifetime=40
width=10
layout=L0
