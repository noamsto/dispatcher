# F23: a pane that is re-stamped between startup and the first delivery (another
# role, another window branch, another crew, as after a remux restore) gets no
# capture and no paste. The queued assignment is reported assignment_orphaned to
# the sender and the dispatcher, and the watcher exits 0. The fake applies the
# override after the first liveness read, i.e. before the delivery's stamp check.
exec git init -q
mkdir .git/crew
mkdir tmux
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock

# another role
cp events.jsonl .git/crew/events.jsonl
cp state tmux/state
cp after-role tmux/after-alive-1
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
! grep '^(capture-pane|send-keys|load-buffer|paste-buffer)' tmux.log
grep -count=2 'assignment_orphaned' .git/crew/events.jsonl
grep '"to":"worker:feat/9-x#s1-1".*pane %6 is no longer stamped as reviewer on feat/9-x' .git/crew/events.jsonl
grep '"to":"dispatcher:c1".*assignment_orphaned' .git/crew/events.jsonl

# another window branch
rm tmux.log tmux/n.alive
cp events.jsonl .git/crew/events.jsonl
cp state tmux/state
cp after-branch tmux/after-alive-1
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
! grep '^(capture-pane|send-keys|load-buffer|paste-buffer)' tmux.log
grep -count=2 'assignment_orphaned' .git/crew/events.jsonl

# another crew
rm tmux.log tmux/n.alive
cp events.jsonl .git/crew/events.jsonl
cp state tmux/state
cp after-crew tmux/after-alive-1
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
! grep '^(capture-pane|send-keys|load-buffer|paste-buffer)' tmux.log
grep -count=2 'assignment_orphaned' .git/crew/events.jsonl

-- events.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"go"}
-- clock --
1000
-- state --
role=reviewer
window=@1
branch=feat/9-x
crew=c1
exited=0
lifetime=6
-- after-role --
role=planner
-- after-branch --
branch=feat/other
-- after-crew --
crew=c9
