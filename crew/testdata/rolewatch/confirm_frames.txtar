rm tmux.log tmux/n.alive tmux/n.capture tmux/n.enter tmux/buffer tmux/loads
cp events.wrapped .git/crew/events.jsonl
cp $FRAMES/rw_cursor_idle_empty.txt tmux/frames/1
cp $FRAMES/rw_cursor_after_mismatched_wrapped_assignment.txt tmux/frames/2
rm tmux/frames/3
exec crew role-watch reviewer --pane %6 --engine cursor --branch feat/9-x --interval 0.2
! stderr .
