# Engine pi, one Enter retry: the box keeps showing the assignment, so the retry
# Enter goes out, then the pi retype re-queues the text (next delivery sends C-u
# and re-pastes it). Held again after that, assignment_unsubmitted goes to the
# sender and the dispatcher once.
#
# golden.log is the bash arm's tmux argv log for this fake state, frozen when
# the arm was deleted.
exec git init -q
mkdir .git/crew
cp events.jsonl .git/crew/events.jsonl
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock
exec crew role-watch reviewer --pane %6 --engine pi --branch feat/9-x --interval 0.2 --submit-retries 1
! stderr .
cmp tmux.log golden.log
grep -count=1 '^send-keys -t %6 C-u$' tmux.log
grep -count=2 '^load-buffer' tmux.log
grep -count=2 '^paste-buffer' tmux.log
grep -count=4 '^send-keys -t %6 Enter$' tmux.log
grep -count=2 'assignment_unsubmitted' .git/crew/events.jsonl
grep '"to":"worker:feat/9-x#s1-1".*assignment_unsubmitted.*after 1 Enter retries' .git/crew/events.jsonl
grep '"to":"dispatcher:c1".*assignment_unsubmitted' .git/crew/events.jsonl

-- events.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"go"}
-- clock --
1000
-- tmux/state --
role=reviewer
window=@1
branch=feat/9-x
crew=c1
exited=0
lifetime=40
-- tmux/frames/1 --
 pi v0.87.1
──────────────────────────────────────────────────────────────────────────────

──────────────────────────────────────────────────────────────────────────────
~/git/dispatcher
0.0%/0 (auto)                                                        unknown
-- tmux/frames/2 --
 pi v0.87.1
──────────────────────────────
Assignment: go
──────────────────────────────
~/git/dispatcher
0.0%/0 (auto)      unknown
