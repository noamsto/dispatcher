# F24: the pane is re-stamped (role planner) right after the delivery Enter. The
# text still sits in the box, but the submit check re-reads the stamp before a
# retry Enter, finds it foreign and sends nothing: assignment_orphaned to the
# sender and the dispatcher, then exit 0 on its own (the pane outlives the run).
#
# golden.log is the bash arm's tmux argv log for this fake state, frozen when
# the arm was deleted.
exec git init -q
mkdir .git/crew
cp events.jsonl .git/crew/events.jsonl
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
grep -count=1 '^send-keys -t %6 Enter$' tmux.log
cmp tmux.log golden.log
grep -count=1 '^paste-buffer' tmux.log
grep -count=2 'assignment_orphaned' .git/crew/events.jsonl
grep '"to":"worker:feat/9-x#s1-1".*assignment_orphaned' .git/crew/events.jsonl
grep '"to":"dispatcher:c1".*assignment_orphaned' .git/crew/events.jsonl

-- events.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"go"}
-- clock --
1000
-- tmux/state --
role=reviewer
window=@1
branch=feat/9-x
crew=c1
exited=0
lifetime=30
-- tmux/after-enter-1 --
role=planner
-- tmux/frames/1 --
✻ Churned for 36s · done 11:20 AM · 1 shell still running
──────────────────
❯
──────────────────
  -- INSERT -- ⏵⏵ auto mode on · 1 shell · ← for agents
-- tmux/frames/2 --
✻ Churned for 36s · done 11:20 AM · 1 shell still running
──────────────────
❯ Assignment: go
──────────────────
  -- INSERT -- ⏵⏵ auto mode on · 1 shell · ← for agents
-- golden.log --
display-message -p -t %6 #{@crew_role}|#{window_id}|#{@crew_delivery}
show-options -wqv -t @1 @crew_branch
show-options -wqv -t @1 @crew_id
display-message -p -t %6 #{@crew_exited}
set-option -p -t %6 @crew_state idle
display-message -p -t %6 #{pane_id}
display-message -p -t %6 #{@crew_exited}
display-message -p -t %6 #{@crew_exited}
set-option -p -t %6 @crew_state working
display-message -p -t %6 #{@crew_exited}
display-message -p -t %6 #{@crew_role}|#{window_id}
show-options -wqv -t @1 @crew_branch
show-options -wqv -t @1 @crew_id
capture-pane -e -p -t %6
load-buffer -b rw-assign-N -
paste-buffer -p -d -r -b rw-assign-N -t %6
capture-pane -e -p -t %6
send-keys -t %6 Enter
display-message -p -t %6 #{pane_id}
display-message -p -t %6 #{@crew_exited}
display-message -p -t %6 #{pane_id}
display-message -p -t %6 #{@crew_exited}
capture-pane -e -p -t %6
display-message -p -t %6 #{@crew_role}|#{window_id}
show-options -wqv -t @1 @crew_branch
show-options -wqv -t @1 @crew_id
list-panes -a -F #{pane_pid}#{@crew_branch}#{@crew_role}#{@crew_id}#{window_id}#{pane_id}
list-panes -a -F #{pane_pid}#{@crew_branch}#{@crew_role}#{@crew_id}#{window_id}#{pane_id}
