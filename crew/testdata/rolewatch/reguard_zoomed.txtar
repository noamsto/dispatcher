# A zoomed window is never re-guarded (select-layout would unzoom it): the
# narrow pane with an unknown frame costs only unknown ticks.
#
# golden.log is the bash arm's tmux argv log for this fake state, frozen when
# the arm was deleted.
exec git init -q
mkdir .git/crew
cp events.jsonl .git/crew/events.jsonl
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
cmp tmux.log golden.log
grep -count=2 'assignment_unsubmitted' .git/crew/events.jsonl
grep '"to":"worker:feat/9-x#s1-1".*assignment_unsubmitted.*the pane matches no recognised frame' .git/crew/events.jsonl
grep '"to":"dispatcher:c1".*assignment_unsubmitted.*the pane matches no recognised frame' .git/crew/events.jsonl
grep '^display-message -p -t @1 #\{window_zoomed_flag\}$' tmux.log
! grep '^(set-window-option|select-layout|list-panes -t)' tmux.log

-- events.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"go"}
-- clock --
1000
-- tmux/state --
role=reviewer
window=@1
branch=feat/9-x
crew=c1
exited=0
lifetime=40
width=10
zoomed=1
layout=L0
-- tmux/frames/1 --
✻ Churned for 36s · done 11:20 AM · 1 shell still running
──────────────────
❯
──────────────────
  -- INSERT -- ⏵⏵ auto mode on · 1 shell · ← for agents
-- tmux/frames/2 --
✻ Churned for 36s · done 11:20 AM · 1 shell still running
──────────────────
❯ Assignment: go
──────────────────
  -- INSERT -- ⏵⏵ auto mode on · 1 shell · ← for agents
-- tmux/frames/3 --
a pane that renders no known frame
