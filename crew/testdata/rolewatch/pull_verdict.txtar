# A pull role's verdict msg (to the lead, no event field) proves it pulled
# whatever preceded it: only entries with ts <= the verdict's ts are cleared. The
# later assignment stays queued and still drives the unstarted-role deferral.
exec git init -q
mkdir .git/crew
cp events.jsonl .git/crew/events.jsonl
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock
exec crew role-watch reviewer --pane %6 --engine cursor --branch feat/9-x --interval 0.2 --defer-notice 1
! stderr .
! grep '^(capture-pane|send-keys|load-buffer|paste-buffer)' tmux.log
grep -count=1 '^set-option -p -t %6 @crew_state idle$' tmux.log
grep -count=1 'assignment_deferred' .git/crew/events.jsonl
grep '"to":"worker:feat/9-x#s1-1".*has not announced itself' .git/crew/events.jsonl

-- events.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"one"}
{"ts":10000000000002,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"two"}
{"ts":10000000000001,"crew_id":"c1","kind":"msg","from":"role:feat/9-x:reviewer","to":"worker:feat/9-x#s1-1","body":"{\"verdict\":\"ok\"}"}
-- clock --
1000
-- tmux/state --
role=reviewer
window=@1
delivery=pull
branch=feat/9-x
crew=c1
exited=0
lifetime=12
