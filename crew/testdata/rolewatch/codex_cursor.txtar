# Codex and cursor deliver only into their exact empty-idle capture, and confirm
# only the exact composer text `Assignment: go` (frame 2) before sending Enter.
exec git init -q
mkdir .git/crew
mkdir tmux/frames
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock

# codex
cp events.jsonl .git/crew/events.jsonl
cp frames/codex_idle tmux/frames/1
cp frames/codex_after tmux/frames/2
cp frames/codex_idle tmux/frames/3
exec crew role-watch reviewer --pane %6 --engine codex --branch feat/9-x --interval 0.2
! stderr .
grep '\AAssignment: go\z' tmux/buffer
grep -count=1 '^paste-buffer' tmux.log
grep -count=1 '^send-keys -t %6 Enter$' tmux.log
! grep '^send-keys -t %6 C-u' tmux.log
! grep '"from":"role:' .git/crew/events.jsonl

# cursor
rm tmux.log tmux/n.alive tmux/n.capture tmux/n.enter tmux/buffer
cp events.jsonl .git/crew/events.jsonl
cp frames/cursor_idle tmux/frames/1
cp frames/cursor_after tmux/frames/2
cp frames/cursor_idle tmux/frames/3
exec crew role-watch reviewer --pane %6 --engine cursor --branch feat/9-x --interval 0.2
! stderr .
grep '\AAssignment: go\z' tmux/buffer
grep -count=1 '^paste-buffer' tmux.log
grep -count=1 '^send-keys -t %6 Enter$' tmux.log
! grep '^send-keys -t %6 C-u' tmux.log
! grep '"from":"role:' .git/crew/events.jsonl

-- events.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"go"}
-- clock --
1000
-- tmux/state --
role=reviewer
window=@1
branch=feat/9-x
crew=c1
exited=0
lifetime=6
