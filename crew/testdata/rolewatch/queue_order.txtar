# Queued assignments go out one per delivery, in order: the second is pasted
# only after the first was typed, confirmed and entered, and each gets its own
# Enter.
exec git init -q
mkdir .git/crew
cp events.jsonl .git/crew/events.jsonl
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
cmp tmux/loads want.loads
grep -count=2 '^paste-buffer' tmux.log
grep -count=2 '^send-keys -t %6 Enter$' tmux.log
! grep '^send-keys -t %6 C-u' tmux.log
grep '(?s)paste-buffer.*send-keys -t %6 Enter.*paste-buffer.*send-keys -t %6 Enter' tmux.log

-- events.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"go"}
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"two"}
-- clock --
1000
-- want.loads --
1 Assignment: go
4 Assignment: two
-- tmux/state --
role=reviewer
window=@1
branch=feat/9-x
crew=c1
exited=0
lifetime=14
