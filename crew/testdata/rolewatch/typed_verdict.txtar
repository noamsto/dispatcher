# A typed delivery is submitted (the idle frame after the Enter). The role then
# posts a verdict msg (no event field) to the lead: the pane goes idle, a second
# @crew_state idle after the delivery on top of the startup one.
exec git init -q
mkdir .git/crew
cp events.jsonl .git/crew/events.jsonl
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
grep -count=2 '^set-option -p -t %6 @crew_state idle$' tmux.log
grep '(?s)send-keys -t %6 Enter\n.*@crew_state idle' tmux.log

-- events.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"go"}
-- clock --
1000
-- tmux/state --
role=reviewer
window=@1
branch=feat/9-x
crew=c1
exited=0
lifetime=12
