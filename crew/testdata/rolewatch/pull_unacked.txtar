# A pull role that announced itself but did not ack (a bare `working` status, or
# the boot announce `parked, awaiting assignment`; neither detail starts with
# `assignment:`) leaves the assignment un-acked: the lead worker hears
# assignment_deferred once, naming pull and `has not acked`, and the pane is
# never marked working.
exec git init -q
mkdir .git/crew
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock

# a bare working status
cp events-bare.jsonl .git/crew/events.jsonl
exec crew role-watch reviewer --pane %6 --engine cursor --branch feat/9-x --interval 0.2 --defer-notice 1
! stderr .
grep -count=1 'assignment_deferred' .git/crew/events.jsonl
grep '"to":"worker:feat/9-x#s1-1".*assignment_deferred.*\\"delivery\\":\\"pull\\"' .git/crew/events.jsonl
grep 'has not acked this one' .git/crew/events.jsonl
! grep 'has not announced' .git/crew/events.jsonl
! grep '@crew_state working' tmux.log
! grep '^(capture-pane|send-keys|load-buffer|paste-buffer)' tmux.log

# the boot announce
rm tmux.log tmux/n.alive
cp events-boot.jsonl .git/crew/events.jsonl
exec crew role-watch reviewer --pane %6 --engine cursor --branch feat/9-x --interval 0.2 --defer-notice 1
! stderr .
grep -count=1 'assignment_deferred' .git/crew/events.jsonl
grep '"to":"worker:feat/9-x#s1-1".*assignment_deferred.*\\"delivery\\":\\"pull\\"' .git/crew/events.jsonl
grep 'has not acked this one' .git/crew/events.jsonl
! grep '@crew_state working' tmux.log
! grep '^(capture-pane|send-keys|load-buffer|paste-buffer)' tmux.log

-- events-bare.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"plan the seam"}
{"ts":10000000000001,"crew_id":"c1","kind":"status","from":"role:feat/9-x:reviewer","to":"dispatcher:c1","body":{"state":"working"}}
-- events-boot.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"plan the seam"}
{"ts":10000000000001,"crew_id":"c1","kind":"status","from":"role:feat/9-x:reviewer","to":"dispatcher:c1","body":{"state":"working"}}
{"ts":10000000000002,"crew_id":"c1","kind":"status","from":"role:feat/9-x:reviewer","to":"dispatcher:c1","body":{"state":"working","detail":"parked, awaiting assignment"}}
-- clock --
1000
-- tmux/state --
role=reviewer
window=@1
delivery=pull
branch=feat/9-x
crew=c1
exited=0
lifetime=12
