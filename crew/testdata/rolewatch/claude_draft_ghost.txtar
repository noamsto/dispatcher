# A real unsent draft in the claude `❯` row (from a colour capture) defers: it
# is captured tick after tick and nothing is typed over it. Ghost
# prompt-suggestion text in the same row (dim SGR) is not a draft, so the
# assignment is delivered, once.
exec git init -q
mkdir .git/crew
mkdir tmux/frames
env DISPATCH_ROLE_WATCH_CLOCK=$WORK/clock

# a draft
cp events.jsonl .git/crew/events.jsonl
cp $FRAMES/rw_claude_draft.color.txt tmux/frames/1
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
grep '(?s)capture-pane.*capture-pane' tmux.log
! grep '^(send-keys|load-buffer|paste-buffer)' tmux.log

# ghost text
rm tmux.log tmux/n.alive tmux/n.capture
cp events.jsonl .git/crew/events.jsonl
cp $FRAMES/rw_claude_ghost.color.txt tmux/frames/1
cp $FRAMES/rw_claude_held.txt tmux/frames/2
cp $FRAMES/rw_idle.txt tmux/frames/3
exec crew role-watch reviewer --pane %6 --engine claude --branch feat/9-x --interval 0.2
! stderr .
grep -count=1 '^load-buffer' tmux.log
grep -count=1 '^paste-buffer' tmux.log
grep -count=1 '^send-keys -t %6 Enter$' tmux.log
! grep '^send-keys -t %6 C-u' tmux.log

-- events.jsonl --
{"ts":9999999999999,"crew_id":"c1","kind":"msg","from":"worker:feat/9-x#s1-1","to":"role:feat/9-x:reviewer","body":"go"}
-- clock --
1000
-- tmux/state --
role=reviewer
window=@1
branch=feat/9-x
crew=c1
exited=0
lifetime=6
