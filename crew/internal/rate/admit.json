{
  "modelMap": {
    "claude": {
      "deep": {
        "default": "opus",
        "models": [
          "opus",
          "claude-opus-*",
          "sonnet",
          "claude-sonnet-*",
          "fable",
          "claude-fable-*"
        ],
        "expected": "opus, claude-opus-*, sonnet, claude-sonnet-*, fable, or claude-fable-*"
      },
      "standard": {
        "default": "sonnet",
        "models": [
          "opus",
          "claude-opus-*",
          "sonnet",
          "claude-sonnet-*",
          "haiku",
          "claude-haiku-*"
        ],
        "expected": "opus, claude-opus-*, sonnet, claude-sonnet-*, haiku, or claude-haiku-*"
      },
      "trivial": {
        "default": "haiku",
        "models": [
          "opus",
          "claude-opus-*",
          "sonnet",
          "claude-sonnet-*",
          "haiku",
          "claude-haiku-*"
        ],
        "expected": "opus, claude-opus-*, sonnet, claude-sonnet-*, haiku, or claude-haiku-*"
      }
    },
    "codex": {
      "deep": {
        "default": "gpt-5.6-sol",
        "models": [
          "gpt-5.6-sol",
          "gpt-5.6-terra",
          "gpt-5.5",
          "gpt-5.4",
          "gpt-5.4-mini"
        ],
        "expected": "gpt-5.6-sol, gpt-5.6-terra, or a legacy generation (gpt-5.5, gpt-5.4, gpt-5.4-mini)"
      },
      "standard": {
        "default": "gpt-5.6-terra",
        "models": [
          "gpt-5.6-terra",
          "gpt-5.6-luna",
          "gpt-5.5",
          "gpt-5.4",
          "gpt-5.4-mini"
        ],
        "expected": "gpt-5.6-terra, gpt-5.6-luna, or a legacy generation (gpt-5.5, gpt-5.4, gpt-5.4-mini)"
      },
      "trivial": {
        "default": "gpt-5.6-luna",
        "models": ["gpt-5.6-luna", "gpt-5.5", "gpt-5.4", "gpt-5.4-mini"],
        "expected": "gpt-5.6-luna or a legacy generation (gpt-5.5, gpt-5.4, gpt-5.4-mini)"
      }
    },
    "cursor": {
      "deep": {
        "default": "kimi-k3-high",
        "models": [
          "kimi-k3-high",
          "grok-4.7-medium",
          "grok-4.7-medium-fast",
          "grok-4.7-high",
          "grok-4.7-high-fast",
          "cursor-grok-4.6-medium",
          "cursor-grok-4.6-medium-fast",
          "cursor-grok-4.6-high",
          "cursor-grok-4.6-high-fast",
          "composer-2.5",
          "composer-2.5-fast"
        ],
        "regex": [
          "^(claude|gpt)(-[a-z0-9.-]*)?-(none|low|medium|high|xhigh|max)(-fast)?(\\[[a-z]+=[a-z0-9.-]+(,[a-z]+=[a-z0-9.-]+)*\\])?$",
          "^(claude|gpt)-[a-z0-9.-]*\\[([a-z]+=[a-z0-9.-]+,)*effort=[a-z0-9.-]+(,[a-z]+=[a-z0-9.-]+)*\\]$"
        ],
        "expected": "kimi-k3-high, grok-4.7-medium[-fast], grok-4.7-high[-fast] (or cursor-grok-4.6-*), composer-2.5[-fast], or an effort-suffixed/bracketed claude-*/gpt-* id"
      },
      "standard": {
        "default": "grok-4.7-medium",
        "models": [
          "grok-4.7-medium",
          "grok-4.7-medium-fast",
          "grok-4.7-low",
          "grok-4.7-low-fast",
          "cursor-grok-4.6-medium",
          "cursor-grok-4.6-medium-fast",
          "cursor-grok-4.6-low",
          "cursor-grok-4.6-low-fast",
          "composer-2.5",
          "composer-2.5-fast"
        ],
        "expected": "grok-4.7-medium[-fast], grok-4.7-low[-fast] (or cursor-grok-4.6-*), or composer-2.5[-fast]"
      },
      "trivial": {
        "default": "grok-4.7-low",
        "models": [
          "grok-4.7-low",
          "grok-4.7-low-fast",
          "cursor-grok-4.6-low",
          "cursor-grok-4.6-low-fast",
          "composer-2.5",
          "composer-2.5-fast"
        ],
        "expected": "grok-4.7-low[-fast] (or cursor-grok-4.6-low*) or composer-2.5[-fast]"
      }
    },
    "pi": {
      "deep": {
        "default": "openrouter/deepseek/deepseek-v4.1-flash",
