  p9 [label="fern\n111" width=0.75 height=0.75 pos="174.21,-138.92!" color="#a6e3a1"];
  p10 [label="dune\n112" width=0.6 height=0.6 pos="96.68,-200.75!" color="#a6e3a1"];
