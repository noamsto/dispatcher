    <tr><td>size = tier&nbsp;&nbsp;&nbsp;&nbsp;<font color="#585b70">●</font> small dot = role&nbsp;&nbsp;&nbsp;&nbsp;<font color="#89b4fa">⇢</font> dashed arrow = stacked on&nbsp;&nbsp;&nbsp;&nbsp;⬡ = remote host</td></tr>
