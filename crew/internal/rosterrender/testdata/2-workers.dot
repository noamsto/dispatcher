digraph roster {
  layout=neato; splines=false; outputorder=edgesfirst; pad=0.2; labelloc=b;
  bgcolor="#1e1e2e"; fontname="Source Sans 3"; fontsize=13; fontcolor="#a6adc8";
  node [shape=circle style=filled fontname="Source Sans 3" fontsize=12 fontcolor="#cdd6f4" fillcolor="#313244" penwidth=3 fixedsize=true];
  edge [color="#585b70" penwidth=1.5 arrowhead=none];
  c1 [label="" style=invis shape=point width=0 pos="-358.67,301.67!"];
  c2 [label="" style=invis shape=point width=0 pos="358.67,301.67!"];
  c3 [label="" style=invis shape=point width=0 pos="-358.67,-301.67!"];
  c4 [label="" style=invis shape=point width=0 pos="358.67,-301.67!"];
  dispatcher [label="dispatcher" width=1 height=1 pos="0.00,0.00!" color="#f9e2af" fillcolor="#45475a"];
  p1 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1" width="171.2"><tr><td align="left">lime · #1&#160;&#160;<font color="#a6e3a1">working</font></td></tr><tr><td align="left">Port the</td></tr><tr><td align="left">Supercalifragilisticexpialidociou…</td></tr><tr><td align="left"><font color="#a6adc8">standard·claude·sonnet</font></td></tr><tr><td align="left"><font color="#6c7086">waiting for the plan critic's…</font></td></tr></table>> shape=box width=2.6 height=1.3 fontsize=11 pos="0.00,-170.00!" style="rounded,filled" color="#a6e3a1" fillcolor="#313244" penwidth=3];
  p2 [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1" width="171.2"><tr><td align="left">sky · #2&#160;&#160;<font color="#f38ba8">blocked</font></td></tr><tr><td align="left">Fix the flaky retry in the sync</td></tr><tr><td align="left">watcher</td></tr><tr><td align="left"><font color="#a6adc8">deep·pi·deepseek-v4.1-flash</font></td></tr><tr><td align="left"><font color="#6c7086">reading crew/internal/rosterr…</font></td></tr></table>> shape=box width=2.6 height=1.3 fontsize=11 pos="0.00,170.00!" style="rounded,filled" color="#f38ba8" fillcolor="#313244" penwidth=4.5 class="aeye-pulse"];
  dispatcher -> p1 [class="aeye-flow"];
  dispatcher -> p2;
  p1m1 [label="" width=0.16 height=0.16 pos="0.00,-232.30!" fillcolor="#a6e3a1" penwidth=0 class="aeye-glow"];
  p1 -> p1m1 [color="#45475a"];
  label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="4">
    <tr><td><font color="#a6e3a1">●</font> working 1&nbsp;&nbsp;&nbsp;&nbsp;<font color="#f38ba8">●</font> blocked 1&nbsp;&nbsp;&nbsp;&nbsp;<font color="#89b4fa">●</font> pr open 0&nbsp;&nbsp;&nbsp;&nbsp;<font color="#45475a">●</font> done 0</td></tr>
    <tr><td>border colour = state&nbsp;&nbsp;&nbsp;&nbsp;border weight = tier</td></tr>
    <tr><td><font color="#585b70">●</font> small dot = role&nbsp;&nbsp;&nbsp;&nbsp;hexagon = remote host</td></tr>
    <tr><td><font color="#89b4fa">→</font> dashed arrow = stacked on</td></tr>
    <tr><td><font color="#6c7086">crew weight 0 · fleet budget ?</font></td></tr>
  </table>>;
}
