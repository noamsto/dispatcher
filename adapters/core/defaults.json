  "burnClasses": [
    {
      "match": "*opus*",
      "byEffort": {
        "low": {"class": "standard", "weight": 2},
        "medium": {"class": "premium", "weight": 4},
        "xhigh": {"class": "premium", "weight": 6},
        "max": {"class": "premium", "weight": 8},
        "default": {"class": "premium", "weight": 4}
      }
    },
    {"match": "composer-2.5*", "class": "free", "weight": 0},
    {"match": "*haiku*", "class": "cheap", "weight": 1},
    {"match": "gpt-5.6-luna", "class": "cheap", "weight": 1},
    {"match": "*grok-4.[0-9]-low", "class": "cheap", "weight": 1},
    {"match": "*sonnet*", "class": "standard", "weight": 2},
    {"match": "gpt-5.6-terra", "class": "standard", "weight": 2},
    {"match": "*grok-4.[0-9]-medium", "class": "standard", "weight": 2},
    {"match": "*grok-4.[0-9]-low-fast", "class": "standard", "weight": 2},
    {"match": "gpt-5.6-sol", "class": "premium", "weight": 4},
    {"match": "*grok-4.[0-9]-high", "class": "premium", "weight": 4},
    {"match": "*grok-4.[0-9]-medium-fast", "class": "premium", "weight": 4},
    {"match": "*grok-4.[0-9]-xhigh", "class": "premium", "weight": 6},
    {"match": "*grok-4.[0-9]-high-fast", "class": "premium", "weight": 8},
    {"match": "*grok-4.[0-9]-xhigh-fast", "class": "premium", "weight": 12},
    {"match": "*fable*", "class": "fable", "weight": 8}
  ],
  "orchestratorDefaults": {
    "claude": {"model": "opus", "effort": "high", "autoCompact": 300000},
    "codex": {"model": "gpt-5.6-sol", "effort": "high", "autoCompact": 300000},
    "cursor": {"model": "kimi-k3-high"},
    "pi": {"model": "openrouter/deepseek/deepseek-v4.1-flash", "effort": "high"}
  },
  "rosterDiagram": {"autoOpen": true},
  "workerDeniedMcpServers": ["plugin_hm_playwright", "plugin_hm_firefox-devtools"],
  "dispatcherChrome": false,
  "freshSeams": false,
  "dispatcherMcp": {},
  "mcpServers": {
    "sentry": {"url": "https://mcp.sentry.dev/mcp", "description": "Sentry issues, events and releases"},
    "posthog": {"url": "https://mcp.posthog.com/mcp", "description": "PostHog product analytics, insights and feature flags"},
    "elevenlabs": {"url": "https://api.elevenlabs.io/v1/mcp", "description": "ElevenLabs voices, speech and agents"}
  },
  "fleetBudget": 8
}
