{
  "modelMap": {
    "claude": {
      "deep": {
        "default": "opus",
        "models": [
          "opus",
          "claude-opus-*",
          "sonnet",
          "claude-sonnet-*",
          "fable",
          "claude-fable-*"
        ],
        "expected": "opus, claude-opus-*, sonnet, claude-sonnet-*, fable, or claude-fable-*"
      },
      "standard": {
        "default": "sonnet",
        "models": [
          "opus",
          "claude-opus-*",
          "sonnet",
          "claude-sonnet-*",
          "haiku",
          "claude-haiku-*"
        ],
        "expected": "opus, claude-opus-*, sonnet, claude-sonnet-*, haiku, or claude-haiku-*"
      },
      "trivial": {
        "default": "haiku",
        "models": [
          "opus",
          "claude-opus-*",
          "sonnet",
          "claude-sonnet-*",
          "haiku",
          "claude-haiku-*"
        ],
        "expected": "opus, claude-opus-*, sonnet, claude-sonnet-*, haiku, or claude-haiku-*"
      }
    },
    "codex": {
      "deep": {
        "default": "gpt-5.6-sol",
        "models": [
          "gpt-5.6-sol",
          "gpt-5.6-terra",
          "gpt-5.5",
          "gpt-5.4",
          "gpt-5.4-mini"
        ],
        "expected": "gpt-5.6-sol, gpt-5.6-terra, or a legacy generation (gpt-5.5, gpt-5.4, gpt-5.4-mini)"
      },
      "standard": {
        "default": "gpt-5.6-terra",
        "models": [
          "gpt-5.6-terra",
          "gpt-5.6-luna",
          "gpt-5.5",
          "gpt-5.4",
          "gpt-5.4-mini"
        ],
        "expected": "gpt-5.6-terra, gpt-5.6-luna, or a legacy generation (gpt-5.5, gpt-5.4, gpt-5.4-mini)"
      },
      "trivial": {
        "default": "gpt-5.6-luna",
        "models": [
          "gpt-5.6-luna",
          "gpt-5.5",
          "gpt-5.4",
          "gpt-5.4-mini"
        ],
        "expected": "gpt-5.6-luna or a legacy generation (gpt-5.5, gpt-5.4, gpt-5.4-mini)"
      }
    },
    "cursor": {
      "deep": {
        "default": "kimi-k3-high",
        "models": [
          "kimi-k3-high",
          "grok-4.7-medium",
          "grok-4.7-medium-fast",
          "grok-4.7-high",
          "grok-4.7-high-fast",
          "cursor-grok-4.6-medium",
          "cursor-grok-4.6-medium-fast",
          "cursor-grok-4.6-high",
          "cursor-grok-4.6-high-fast",
          "composer-2.5",
          "composer-2.5-fast"
        ],
        "regex": [
          "^(claude|gpt)(-[a-z0-9.-]*)?-(none|low|medium|high|xhigh|max)(-fast)?(\\[[a-z]+=[a-z0-9.-]+(,[a-z]+=[a-z0-9.-]+)*\\])?$",
          "^(claude|gpt)-[a-z0-9.-]*\\[([a-z]+=[a-z0-9.-]+,)*effort=[a-z0-9.-]+(,[a-z]+=[a-z0-9.-]+)*\\]$"
        ],
        "expected": "kimi-k3-high, grok-4.7-medium[-fast], grok-4.7-high[-fast] (or cursor-grok-4.6-*), composer-2.5[-fast], or an effort-suffixed/bracketed claude-*/gpt-* id"
      },
      "standard": {
        "default": "grok-4.7-medium",
        "models": [
          "grok-4.7-medium",
          "grok-4.7-medium-fast",
          "grok-4.7-low",
          "grok-4.7-low-fast",
          "cursor-grok-4.6-medium",
          "cursor-grok-4.6-medium-fast",
          "cursor-grok-4.6-low",
          "cursor-grok-4.6-low-fast",
          "composer-2.5",
          "composer-2.5-fast"
        ],
        "expected": "grok-4.7-medium[-fast], grok-4.7-low[-fast] (or cursor-grok-4.6-*), or composer-2.5[-fast]"
      },
      "trivial": {
        "default": "grok-4.7-low",
        "models": [
          "grok-4.7-low",
          "grok-4.7-low-fast",
          "cursor-grok-4.6-low",
          "cursor-grok-4.6-low-fast",
          "composer-2.5",
          "composer-2.5-fast"
        ],
        "expected": "grok-4.7-low[-fast] (or cursor-grok-4.6-low*) or composer-2.5[-fast]"
      }
    },
    "pi": {
      "deep": {
        "default": "openrouter/deepseek/deepseek-v4.1-flash",
        "models": [
          "openrouter/deepseek/deepseek-v4.1-flash",
          "openrouter/deepseek/deepseek-v4.1-flash-1017"
        ],
        "expected": "openrouter/deepseek/deepseek-v4.1-flash or openrouter/deepseek/deepseek-v4.1-flash-1017"
      },
      "standard": {
        "default": "openrouter/deepseek/deepseek-v4.1-flash",
        "models": [
          "openrouter/deepseek/deepseek-v4.1-flash",
          "openrouter/deepseek/deepseek-v4.1-flash-1017",
          "openrouter/deepseek/deepseek-v4-flash",
          "openrouter/z-ai/glm-5.3-flash",
          "openrouter/qwen/qwen3.8-flash"
        ],
        "expected": "openrouter/deepseek/deepseek-v4.1-flash, openrouter/deepseek/deepseek-v4.1-flash-1017, openrouter/deepseek/deepseek-v4-flash, openrouter/z-ai/glm-5.3-flash, or openrouter/qwen/qwen3.8-flash"
      },
      "trivial": {
        "default": "openrouter/deepseek/deepseek-v4.1-flash",
        "models": [
          "openrouter/deepseek/deepseek-v4.1-flash",
          "openrouter/deepseek/deepseek-v4.1-flash-1017",
          "openrouter/deepseek/deepseek-v4-flash"
        ],
        "expected": "openrouter/deepseek/deepseek-v4.1-flash, openrouter/deepseek/deepseek-v4.1-flash-1017, or openrouter/deepseek/deepseek-v4-flash"
      }
    }
  },
  "classes": {
    "claude": {
      "cheap": ["haiku", "claude-haiku-*"],
      "standard": ["sonnet", "claude-sonnet-*"],
      "premium": ["opus", "claude-opus-*"],
      "tiers": {
        "deep": {"class": "premium", "admits": ["standard", "premium"]},
        "standard": {"class": "standard", "admits": ["cheap", "standard", "premium"]},
        "trivial": {"class": "cheap", "admits": ["cheap", "standard", "premium"]}
      }
    },
    "codex": {
      "cheap": ["gpt-*-luna"],
      "standard": ["gpt-*-terra"],
      "premium": ["gpt-*-sol"],
      "tiers": {
        "deep": {"class": "premium", "admits": ["standard", "premium"]},
        "standard": {"class": "standard", "admits": ["cheap", "standard"]},
        "trivial": {"class": "cheap", "admits": ["cheap"]}
      }
    },
    "cursor": {
      "cheap": ["grok-*-low", "grok-*-low-fast", "cursor-grok-*-low", "cursor-grok-*-low-fast"],
      "standard": ["grok-*-medium", "grok-*-medium-fast", "cursor-grok-*-medium", "cursor-grok-*-medium-fast"],
      "premium": ["kimi-*-high", "grok-*-high", "grok-*-high-fast", "cursor-grok-*-high", "cursor-grok-*-high-fast"],
      "tiers": {
        "deep": {"class": "premium", "admits": ["standard", "premium"]},
        "standard": {"class": "standard", "admits": ["cheap", "standard"]},
        "trivial": {"class": "cheap", "admits": ["cheap"]}
      }
    },
    "pi": {
      "standard": [
        "openrouter/deepseek/deepseek-v*-flash",
        "openrouter/z-ai/glm-*-flash",
        "openrouter/qwen/qwen*-flash"
      ],
      "premium": [{"glob": "openrouter/anthropic/claude-opus-*", "requires": "pi_month_target"}],
      "tiers": {
        "deep": {"class": "standard", "admits": ["standard", "premium"]},
        "standard": {"class": "standard", "admits": ["standard"]},
        "trivial": {"class": "standard", "admits": ["standard"]}
      }
    }
  },
