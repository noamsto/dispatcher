  "paceDowngrades": {
    "claude": [
      {
        "models": [
          "opus",
          "claude-opus-*",
          "fable",
          "claude-fable-*"
        ],
        "to": "sonnet"
      }
    ],
    "codex": [
      {
        "models": [
          "gpt-5.6-sol"
        ],
        "to": "gpt-5.6-terra"
      },
      {
        "models": [
          "@premium"
        ],
        "to": "@standard"
      }
    ],
    "cursor": [
      {
        "models": [
          "grok-4.7-high",
          "grok-4.7-high\\[*"
        ],
        "to": "grok-4.7-medium"
      },
      {
        "models": [
          "cursor-grok-4.6-high",
          "cursor-grok-4.6-high\\[*"
