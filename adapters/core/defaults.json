        "to": "cursor-grok-4.6-medium"
      },
      {
        "models": [
          "@premium:grok-*-high"
        ],
        "to": "grok-4.7-medium"
      },
      {
        "models": [
          "@premium:cursor-grok-*-high"
        ],
