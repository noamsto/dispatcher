{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT\"/scripts/secret-read-guard.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT\"/scripts/dispatch-notify.sh"
          }
        ]
      }
    ]
  }
}
