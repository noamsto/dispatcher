direction: right

ident: "NEW tmux_server = pid:start_time of the server the window was opened on"
dispatch: "CHANGED dispatch.sh: window row carries window_id + tmux_server"
resume: "CHANGED dispatch-resume.sh: resume row carries window_id + tmux_server"
log: "crew/events.jsonl: window_id + tmux_server"
arm: "CHANGED nudge/arm.go: list-windows -a answers #{pid}:#{start_time}"
where: "CHANGED where/where.go: readWindows reads the live server identity"
bound: "CHANGED remote.WindowBound: id equal AND (row has no tmux_server OR identity equal)"
call: "crew nudge / crew where on a visiting crew"

ident -> dispatch
ident -> resume
dispatch -> log
resume -> log
arm -> bound
where -> bound
log -> bound
bound -> call: "a row from a dead server binds nothing"

ident.style.stroke: "#c1121f"
ident.style.stroke.width: 3
dispatch.style.stroke: "#c1121f"
resume.style.stroke: "#c1121f"
arm.style.stroke: "#c1121f"
where.style.stroke: "#c1121f"
bound.style.stroke: "#c1121f"
