direction: right

side: "tmux-crew-dash --side\nexec crew dash --narrow\n(no crew arg, no CREW_ID)"
crews: "crew crews\n(every crew on the repo bus)"
roster: "data.CollectRoster\nkeeps every alive crew" {class: warn}
header: "ui.crewHeader\njoins all crew ids" {class: warn}
attn: "view.buildAttention\nlane dead/stale → critical\nno live-work check" {class: warn}
scanner: "data.BusScanner\none 50-row Recent ring"
events: "BuildOverview Events\nunfiltered, other crews" {class: warn}
age: "ui.ovAge / view.fmtDur\nseconds tick; narrow line\nvariable-width age" {class: warn}
panel: "side panel frame"

side -> roster: collect
crews -> roster: alive=yes rows
roster -> header: 2 crews
roster -> attn: finished + fresh crew lanes
scanner -> events: bus-wide rows
header -> panel
attn -> panel: "2 need action"
events -> panel: hours-old rows
age -> panel: line jitter
