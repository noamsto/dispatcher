direction: down
grid-columns: 2
grid-gap: 24

classes: {
  repo: {
    style: {
      stroke: "#1565C0"
      stroke-width: 2
      border-radius: 6
      font-size: 18
    }
  }
  unused: {
    style: {
      stroke: "#1565C0"
      stroke-width: 2
      stroke-dash: 4
      border-radius: 6
      font-size: 18
    }
  }
  verified: {
    style: {
      stroke: "#C62828"
      stroke-width: 3
      font-size: 20
      bold: true
    }
  }
  partial: {
    style: {
      stroke: "#EF6C00"
      stroke-width: 3
      font-size: 20
      bold: true
    }
  }
  refuted: {
    style: {
      stroke: "#2E7D32"
      stroke-width: 3
      stroke-dash: 6
      font-size: 20
      bold: true
    }
  }
  note: {
    style: {
      stroke: "#757575"
      stroke-width: 2
      stroke-dash: 3
      font-size: 18
    }
  }
  contract: {
    style: {
      stroke: "#2E7D32"
      stroke-width: 2
      font-size: 16
    }
  }
}

o1: "O1  Control-mode parser" {
  class: verified
  grid-columns: 2
  houston: houston {class: repo}
  tmuxog: tmux-og {class: repo}
}

o2: "O2  Agent state vocabularies" {
  class: verified
  grid-columns: 3
  houston: houston {class: repo}
  tmuxog: tmux-og {class: repo}
  dispatcher: "dispatcher\n(5 divergent sets)" {class: repo}
}

o3: "O3  Hook/config writers" {
  class: verified
  grid-columns: 4
  hookyard: hookyard {class: repo}
  tmuxog: tmux-og {class: repo}
  remux: tmux-remux {class: repo}
  aeye: "aeye\n(Codex, Cursor, Pi)" {class: repo}
}

o4: "O4  PR state" {
  class: verified
  grid-columns: 3
  prdash: prdash {class: repo}
  dispatcher: dispatcher {class: repo}
  tmuxog: tmux-og {class: repo}
  agentsmith: agent-smith {class: repo}
  wtc: wtc {class: repo}
  forged: "forged\n(built, unconsumed)" {class: unused}
}

o5: "O5  Bus readers" {
  class: partial
  direction: right
  bus: "crew bus\nfiles" {class: note}
  houston: "houston\n(direct files)" {class: repo}
  dash: "dispatcher dash\n(second reader)" {class: repo}
  houston -> bus: reads {style.stroke-width: 2}
  dash -> bus: reads {style.stroke-width: 2}
}

o6: "O6  tmux persistence" {
  class: refuted
  direction: right
  remux: "tmux-remux\n(one engine)" {class: repo}
  tmuxog: "tmux-og\n(consumer)" {class: repo}
  tmuxog -> remux: "manifest contract" {class: contract}
}

o7: "O7  tmux client wrappers" {
  class: partial
  grid-columns: 4
  houston: houston {class: repo}
  remux: tmux-remux {class: repo}
  dispatcher: dispatcher {class: repo}
  tmuxog: tmux-og {class: repo}
}

minor: "O8-O12 minor\nusage probing, transcripts,\nengine lists, CI, small helpers" {class: note}

legend: "Legend" {
  grid-columns: 2
  style.font-size: 18
  v: "Verified duplicate" {class: verified; style.font-size: 16}
  p: "Partial overlap" {class: partial; style.font-size: 16}
  r: "Refuted: one engine" {class: refuted; style.font-size: 16}
  u: "Repo (dashed: unconsumed)" {class: unused; style.font-size: 16}
}
