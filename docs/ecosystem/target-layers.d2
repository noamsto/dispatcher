direction: down
grid-columns: 1
grid-gap: 60

classes: {
  surface: {
    style: {
      stroke: "#6A1B9A"
      stroke-width: 2
      border-radius: 10
      font-size: 18
    }
  }
  actor: {
    style: {
      stroke: "#1565C0"
      stroke-width: 2
      border-radius: 6
      font-size: 18
    }
  }
  satellite: {
    style: {
      stroke: "#1565C0"
      stroke-width: 2
      stroke-dash: 4
      border-radius: 6
      font-size: 18
    }
  }
  contract: {
    shape: hexagon
    style: {
      stroke: "#EF6C00"
      stroke-width: 2
      font-size: 18
    }
  }
  new: {
    style: {
      stroke: "#2E7D32"
      stroke-width: 4
    }
  }
  band: {
    style: {
      font-size: 22
      bold: true
      stroke-width: 1
    }
  }
  uses: {
    style: {
      stroke-width: 2
      font-size: 16
    }
  }
}

surfaces: "SURFACES" {
  class: band
  grid-columns: 5
  dash: "crew dash\nTUI" {class: surface}
  overseer: "overseer\nClaude session / Hermes" {class: surface}
  houston: "houston\nfederated web UI" {class: surface}
  picker: "tmux picker" {class: surface}
  prdash: "prdash\nPR TUI" {class: surface}
}

actors: "ACTORS" {
  class: band
  grid-columns: 9
  dispatcher: "dispatcher\ncrew bus,\nworkflows" {class: actor}
  hookyard: "hookyard\nhook install,\nenvelope" {class: actor}
  tmuxog: "tmux-og\ncontrol-mode\nbridge" {class: actor}
  remux: "tmux-remux\npersistence,\ntmux client" {class: actor}
  forged: "forged\nPR state" {class: actor}
  themestate: "themestate\ntheme state" {class: actor}
  wtc: "wtc\nworktree\ncleanup" {class: satellite}
  agentsmith: "agent-smith\nhistory\nmining" {class: satellite}
  aeye: "aeye\nimage\ncarousel" {class: satellite}
}

contracts: "CONTRACTS" {
  class: band
  label.near: bottom-center
  grid-columns: 9
  bus: "bus envelope\nschema" {class: [contract; new]}
  hook: "hook envelope\npackage" {class: [contract; new]}
  cm: "controlmode\nstdlib package" {class: [contract; new]}
  manifest: "remux manifest\nschema" {class: [contract; new]}
  fc: "forged\nclient" {class: contract}
  theme: "theme-state\nfile" {class: contract}
}

surfaces.dash -> actors.dispatcher: "bus stream" {class: uses}
surfaces.overseer -> actors.dispatcher: "bus stream" {class: uses}
surfaces.houston -> actors.dispatcher: stream {class: uses}
surfaces.houston -> actors.hookyard: envelope {class: uses}
surfaces.houston -> actors.tmuxog: controlmode {class: uses}
surfaces.prdash -> actors.forged: "forged client" {class: uses}
surfaces.picker -> actors.tmuxog: "in-repo" {class: uses; style.stroke-dash: 4}
actors.dispatcher -> contracts.bus: owns {class: uses}
actors.hookyard -> contracts.hook: owns {class: uses}
actors.tmuxog -> contracts.cm: owns {class: uses}
actors.remux -> contracts.manifest: owns {class: uses}
actors.forged -> contracts.fc: owns {class: uses}
actors.themestate -> contracts.theme: owns {class: uses}

legend: "Legend" {
  grid-columns: 4
  style.font-size: 18
  a: "repo" {class: actor; style.font-size: 16}
  s: "satellite repo" {class: satellite; style.font-size: 16}
  c: "existing contract" {class: contract; style.font-size: 16}
  n: "new contract" {class: [contract; new]; style.font-size: 16}
}
