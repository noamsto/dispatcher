{
  "handlers": [
    {
      "id": "dispatch-notify",
      "exec": "adapters/core/dispatch-notify.sh",
      "events": ["pi:session_shutdown"],
      "engines": ["pi"],
      "lane": "fire_and_forget"
    },
    {
      "id": "secret-read-guard",
      "exec": "adapters/core/secret-read-guard.sh",
      "events": ["pre_tool"],
      "engines": ["pi"],
      "match": ["Bash", "Read", "Grep"],
      "timeout_ms": 4000
    },
    {
      "id": "public-leak-guard",
      "exec": "adapters/core/public-leak-guard.sh",
      "events": ["pre_tool"],
      "engines": ["pi"],
      "match": ["Bash"],
      "timeout_ms": 4000
    },
    {
      "id": "test-scope-guard",
      "exec": "adapters/core/test-scope-guard.sh",
      "events": ["pre_tool"],
      "engines": ["pi"],
      "match": ["Bash"],
      "timeout_ms": 4000
    },
    {
      "id": "phase-status",
      "exec": "adapters/core/phase-status.sh",
      "events": ["post_tool"],
      "engines": ["pi"],
      "lane": "fire_and_forget"
    },
    {
      "id": "phase-status-await",
      "exec": "adapters/core/phase-status.sh",
      "events": ["pre_tool"],
      "engines": ["pi"],
      "match": ["Bash"],
      "timeout_ms": 4000
    },
    {
      "id": "directive-delivery",
      "exec": "adapters/core/directive-delivery.sh",
      "events": ["post_tool"],
      "engines": ["pi"],
      "timeout_ms": 4000
    }
  ]
}
